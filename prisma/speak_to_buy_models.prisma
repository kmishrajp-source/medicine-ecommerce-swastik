
// ============================================================================
// PHASE 9: SPEAK-TO-BUY MEDICINE AI WORKFLOW
// ============================================================================

model MedicineCompliance {
  id              String   @id @default(cuid())
  productId       String   @unique
  product         Product  @relation(fields: [productId], references: [id])
  
  isPrescriptionRequired Boolean @default(false)
  isNarcotic            Boolean @default(false)
  scheduleClass         String? // e.g., "H", "H1", "X"
  maxDispenseQuantity   Int?
  minAge                Int?
  
  complianceNotes       String? @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model VoiceOrderIntent {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation("UserVoiceOrders", fields: [userId], references: [id])
  
  // State Machine: 
  // INITIATED -> AUTHENTICATED -> MED_IDENTIFIED -> RX_CHECK -> 
  // RETAILER_DISCOVERY -> RETAILER_CONFIRMED -> USER_CONFIRMED -> 
  // PAYMENT_PENDING -> PAYMENT_SUCCESS -> RIDER_ASSIGNED -> DELIVERED
  state           String   @default("INITIATED")
  
  // Extracted Data
  rawTranscript   String   @db.Text
  medicineName    String?
  strength        String?
  quantity        Int?
  
  // Workflow Links
  prescriptionId  String?
  prescription    Prescription? @relation("VoiceOrderPrescription", fields: [prescriptionId], references: [id])
  retailerId      String?
  retailer        Retailer? @relation("VoiceOrderRetailer", fields: [retailerId], references: [id])
  orderId         String?
  order           Order?   @relation("VoiceOrderRef", fields: [orderId], references: [id])
  
  pricingDetails  Json? // { mrp, margin, deliveryFee, totalCustomerPrice, retailerSettlement }
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RetailerInventoryResponse {
  id              String   @id @default(cuid())
  voiceOrderId    String
  voiceOrder      VoiceOrderIntent @relation(fields: [voiceOrderId], references: [id])
  retailerId      String
  retailer        Retailer @relation(fields: [retailerId], references: [id])
  
  hasExactMedicine Boolean @default(false)
  hasCorrectStrength Boolean @default(false)
  hasQuantity      Boolean @default(false)
  withinExpiry     Boolean @default(false)
  
  quotedPrice      Float
  status           String  @default("PENDING") // PENDING, CONFIRMED, REJECTED, TIMEOUT
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model OrderAuditLog {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  
  actorType       String   // "AI", "USER", "RETAILER", "RIDER", "SYSTEM"
  actorId         String?  // Reference ID
  
  action          String   // "MEDICINE_IDENTIFIED", "RX_VALIDATED", "RETAILER_CONFIRMED", "PICKUP_VERIFIED"
  previousState   String?
  newState        String?
  reason          String?  @db.Text
  
  timestamp       DateTime @default(now())
  
  @@index([orderId])
}
