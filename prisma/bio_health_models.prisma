
// --- Bio-Health Engine Models ---

model BiomedicalResearch {
  id              String   @id @default(cuid())
  title           String
  source          String   // e.g., "Tier 1: Govt", "Tier 2: Peer Reviewed"
  url             String?
  publicationDate DateTime
  topic           String   // e.g., "Genomics", "Biotechnology"
  summary         String   @db.Text
  evidenceLevel   String   // e.g., "Established", "Emerging", "Experimental"
  status          String   // e.g., "Research", "Clinical", "Commercial"
  limitations     String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ResearchAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserResearchAlerts", fields: [userId], references: [id], onDelete: Cascade)
  topic     String   // e.g., "Diabetes", "Genomics"
  createdAt DateTime @default(now())
  
  @@index([userId])
}

model BiomarkerInfo {
  id             String   @id @default(cuid())
  name           String
  definition     String   @db.Text
  biologicalRole String   @db.Text
  testType       String
  evidence       String   @db.Text
  limitations    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
