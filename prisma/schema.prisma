model MarketingCampaign {
  id                  String  @id @default(cuid())
  title               String
  objective           String // AWARENESS, LEAD_GEN, PRODUCT_SALES, REFILL_RETENTION, B2B_SUPPLIER, DOCTOR_BOOKING
  productOrService    String? // Medicine Name, Lab Test, Doctor Specialty, B2B Bulk Offer
  campaignType        String // ORGANIC, PAID, HYBRID
  targetAudienceGroup String // NEW_PROSPECTS, EXISTING_CUSTOMERS, HIGH_VALUE, B2B_RETAILERS, STOCKISTS, DOCTORS, CHRONIC_CARE

  // Geography
  geographyCountry  String  @default("India")
  geographyState    String  @default("Uttar Pradesh")
  geographyDistrict String? @default("Gorakhpur")
  geographyCity     String  @default("Gorakhpur")
  geographyLocality String?
  geographyRadiusKm Float   @default(15.0)

  // Paid Promotion Intelligence
  budget             Float   @default(0.0)
  spent              Float   @default(0.0)
  paidRecommendation String  @default("TEST_FIRST") // PROMOTE, TEST_FIRST, DO_NOT_PROMOTE
  paidApprovalStatus String  @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy         String?

  // Lifecycle
  status           String @default("DRAFT") // DRAFT, PENDING_APPROVAL, ACTIVE, PAUSED, COMPLETED
  performanceScore Float  @default(0.0)
  metrics          Json? // { impressions, reach, views, clicks, enquiries, leads, orders, revenue, cpl, roas }

