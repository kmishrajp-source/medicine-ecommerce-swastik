generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  name                String?
  role                String               @default("CUSTOMER") // ADMIN, CUSTOMER
  createdAt           DateTime             @default(now())
  orders              Order[]
  subOrders           SubOrder[]
  doctor              Doctor?
  prescriptions       Prescription[]
  lab                 Lab?
  labBookings         LabBooking[]
  retailer            Retailer?
  stockist            Stockist?
  deliveryAgent       DeliveryAgent?
  appointments        Appointment[]
  ambulance           Ambulance[]
  ambulanceBookings   AmbulanceBooking[]
  medicalRep          MedicalRep?
  pharmaCompany       PharmaCompany?
  insuranceCompany    InsuranceCompany?    @relation("CompanyUser", fields: [insuranceCompanyId], references: [id])
  insuranceCompanyId  String?              @unique
  hospital            Hospital?
  insurance           InsuranceProvider?
  manufacturer        Manufacturer?
  claims              InsuranceClaim[]
  medicineRequests    MedicineRequest[]
  subscriptions       Subscription[]
  referralCode        String?              @unique
  referredBy          String?
  walletBalance       Float                @default(0.0)
  transactions        WalletTransaction[]
  withdrawals         Withdrawal[]
  fcmTokens           String[]             @default([]) // Used for Push Notifications
  lastIpAddress       String?
  deviceId            String?
  phoneVerified       Boolean              @default(false)
  complaints          Complaint[]
  suggestions         Suggestion[]
  experiences         CustomerExperience[]
  referralsMade       ReferralConnection[] @relation("ReferrerLinks")
  referralsReceived   ReferralConnection[] @relation("RefereeLink")
  systemFailureLogs   SystemFailureLog[]
  customerLeads       InsuranceLead[]      @relation("CustomerLeads")
  publisherLeads      InsuranceLead[]      @relation("PublisherLeads")
  userLeads           Lead[]               @relation("UserLeads")
  publisherSlnLeads   Lead[]               @relation("PublisherSlnLeads")
  contactUnlocks      ContactUnlock[]      @relation("UserUnlocks")
  systemLogs          SystemLog[]
  publisher           Publisher?
  publisherLeadsTable PublisherLead[]      @relation("UserPublisherLeads")
  assignedLeads       Lead[]               @relation("AgentLeads")
  blogs               BlogPost[]
  RiderCashAccount    RiderCashAccount?
  Distributor         Distributor?
  hospitalAppointments HospitalAppointment[]
  insuranceProfiles   InsuranceProfile[]
  healthcareSearches  HealthcareSearch[]
  researchAlerts      ResearchAlert[]      @relation("UserResearchAlerts")
  bioinformaticsDatasets BioinformaticsDataset[] @relation("UserBioinformaticsDatasets")
  revenueTransactions RevenueTransaction[] @relation("UserRevenueTransactions")

  // --- ABDM Integrations ---
  abhaProfile          AbhaProfile?
  digitalHealthRecords DigitalHealthRecord[]
  consentRequests      ConsentRequest[]      @relation("PatientConsent")
}

model SystemSettings {
  id                  String   @id @default("default") // Enforce singleton pattern
  referralBonusAmount Float    @default(50.0)
  welcomeBonusAmount  Float    @default(50.0)
  minimumWithdrawal   Float    @default(100.0)
  deliveryAgentFee    Float    @default(50.0)
  selfDeliveryBonus   Float    @default(15.0) // Bonus for retailers who deliver themselves
  referralConfig      Json? // Stores dynamic percentages for Doctors, Retailers, etc.
  updatedAt           DateTime @updatedAt
}

model OTP {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiry    DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Product {
  id                   String  @id @default(cuid())
  name                 String
  description          String
  price                Float // Legacy compatibility - Represents the selling price
  image                String
  category             String
  requiresPrescription Boolean @default(false)
  uses                 String?
  sideEffects          String?
  stock                Int     @default(100) // Legacy compatibility

  // --- New Master Fields ---
  composition   String?
  manufacturer  String?
  brand         String?
  salt          String?
  mrp           Float   @default(0.0)
  discount      Float   @default(0.0)
  isRecommended Boolean @default(false)
  packSize      String?

  expiryDate   DateTime?
  batchNumber  String?
  isOTC        Boolean   @default(false)
  isScheduleH1 Boolean   @default(false)
  isColdChain  Boolean   @default(false)
  createdAt    DateTime  @default(now())

  orderItems          OrderItem[]
  stockLogs           StockLog[]
  inventory           PharmacyInventory? // 1-to-1 operational link
  manufacturerId      String?
  manufacturerAccount Manufacturer?      @relation(fields: [manufacturerId], references: [id])
  genericSourceRelations GenericMedicineRelation[] @relation("SourceProduct")
  genericTargetRelations GenericMedicineRelation[] @relation("TargetProduct")

  @@index([name])
  @@index([category])
  @@index([isOTC, requiresPrescription])
}

model Order {
  id                      String               @id @default(cuid())
  userId                  String?
  user                    User?                @relation(fields: [userId], references: [id])
  guestName               String?
  guestEmail              String?
  guestPhone              String?
  address                 String?
  lat                     Float?
  lng                     Float?
  assignedRetailerId      String?
  assignedRetailer        Retailer?            @relation("AssignedOrders", fields: [assignedRetailerId], references: [id])
  declinedRetailers       String[]             @default([]) // Array of Retailer IDs who rejected/timed out
  nearestRetailerIds      String[]             @default([]) // List of up to 3 retailers discovered at creation
  currentRetailerIndex    Int                  @default(0) // Index in nearestRetailerIds currently being offered
  isRetailerDelivering    Boolean              @default(false)
  deliveryFee             Float                @default(50.0)
  deliveryNegotiationLogs Json? // [{retailerId, response, timestamp}]
  deliveryAgentId         String?
  deliveryAgent           DeliveryAgent?       @relation("AssignedDeliveries", fields: [deliveryAgentId], references: [id])
  assignedAt              DateTime?
  total                   Float
  status                  String               @default("Received") // Received, Rx_Uploaded, Pharmacist_Approved, Ready_for_Packing, Out_for_Delivery, Delivered
  paymentMethod           String               @default("ONLINE") // "ONLINE" or "COD"
  deliveryCode            String? // Secret code for COD verification
  isPaid                  Boolean              @default(false)
  isDelivered             Boolean              @default(false)
  codCollectedAmount      Float?               @default(0)
  codReconciled           Boolean              @default(false)
  items                   OrderItem[]
  prescription            Prescription?
  deliveryProofUrl        String?
  tamperSealCode          String? // Unique seal code provided by retailer
  integrityStatus         String?              @default("PENDING") // PENDING, INTACT, TAMPERED, DAMAGED
  integrityCheckAt        DateTime? // When customer verified it
  integrityCheckNotes     String? // Customer feedback if tampered
  createdAt               DateTime             @default(now())
  complaints              Complaint[]
  experience              CustomerExperience?
  subOrders               SubOrder[]
  deliveryAssignments     DeliveryAssignment[]
  deliveryJob             DeliveryJob?         @relation("DeliveryJobOrder")

  // --- Pickup Routing ---
  pickupType              String               @default("RETAILER") // RETAILER, STOCKIST
  pickupId                String?              // Will hold the Retailer ID or Stockist ID depending on pickupType

  // --- Settlement ---
  settlementStatus String @default("PENDING") // PENDING, SETTLED, PARTIAL

  @@index([status])
  @@index([userId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model StockLog {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  buyingPrice Float
  type        String   @default("RESTOCK")
  createdAt   DateTime @default(now())
}

model SMSLog {
  id        String   @id @default(cuid())
  phone     String
  message   String
  status    String // "Sent", "Failed", "Mock"
  response  String? // JSON string of API response
  createdAt DateTime @default(now())
}

model Doctor {
  id                String    @id @default(cuid())
  userId            String?   @unique
  user              User?     @relation(fields: [userId], references: [id])
  name              String? // For unverified/scraped entries
  specialization    String
  hospital          String? // Text name for non-linked hospitals
  hospitalId        String?
  hospitalLink      Hospital? @relation("HospitalDoctors", fields: [hospitalId], references: [id])
  city              String    @default("Gorakhpur")
  experience        Int?
  verified          Boolean   @default(false)
  status            String    @default("unverified") // unverified, verified, claimed
  source            String    @default("field_agent") // google_maps, justdial, field_agent, self_registered
  lat               Float?
  lng               Float?
  phone             String?
  photoUrl          String?
  consultationFee   Float     @default(500.0)
  razorpayAccountId String?
  isDirectory       Boolean   @default(false)
  location          String?
  isClaimed         Boolean   @default(false)

  // Professional Metadata (Screenshot Sync)
  rating              Float  @default(4.0)
  ratingCount         Int    @default(0)
  recommendationRate  Int    @default(80) // %
  patientStoriesCount Int    @default(0)
  openingHours        String @default("9:00 AM - 5:00 PM")

  createdAt     DateTime       @default(now())
  prescriptions Prescription[]
  appointments  Appointment[]
  visits        Visit[]
  reports       Report[]

  // --- ABDM Integrations ---
  hprProfile      DoctorHprProfile?
  consentRequests ConsentRequest[]  @relation("DoctorConsent")
}

model Prescription {
  id        String              @id @default(cuid())
  imageUrl  String
  patientId String
  patient   User                @relation(fields: [patientId], references: [id])
  doctorId  String?
  doctor    Doctor?             @relation(fields: [doctorId], references: [id])
  medicines String? // JSON string or text details
  status    String              @default("Pending") // Pending, Processed, Rejected
  orderId   String?             @unique
  order     Order?              @relation(fields: [orderId], references: [id])
  createdAt DateTime            @default(now())
  quotes    PrescriptionQuote[]
}

model PrescriptionQuote {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  retailerId     String
  retailer       Retailer     @relation(fields: [retailerId], references: [id])
  quotedAmount   Float
  items          Json? // Array of {name, price, stockStatus}
  status         String       @default("PENDING") // PENDING, SELECTED, REJECTED
  createdAt      DateTime     @default(now())
}

model Appointment {
  id          String     @id @default(cuid())
  patientId   String
  patient     User       @relation(fields: [patientId], references: [id])
  doctorId    String
  doctor      Doctor     @relation(fields: [doctorId], references: [id])
  publisherId String?    @map("publisher_id")
  publisher   Publisher? @relation(fields: [publisherId], references: [id])
  date        DateTime
  reason      String?
  status      String     @default("Pending") // Pending, Confirmed, Cancelled
  createdAt   DateTime   @default(now())
  hospitalId  String?
  hospital    Hospital?  @relation(fields: [hospitalId], references: [id])
}

model Lab {
  id            String    @id @default(cuid())
  userId        String?   @unique
  user          User?     @relation(fields: [userId], references: [id])
  name          String
  address       String
  licenseNumber String? // Optional for directory
  phone         String
  city          String    @default("Gorakhpur")
  verified      Boolean   @default(false)
  isDirectory   Boolean   @default(false)
  rating        Float     @default(4.5)
  ratingCount   Int       @default(0)
  status        String    @default("unverified") // unverified, verified, claimed
  source        String    @default("field_agent")
  photoUrl      String?
  openingHours  String    @default("9:00 AM - 9:00 PM")
  lat           Float?
  lng           Float?
  createdAt     DateTime  @default(now())
  tests         LabTest[]
}

model LabTest {
  id             String       @id @default(cuid())
  labId          String
  lab            Lab          @relation(fields: [labId], references: [id])
  name           String
  description    String?
  category       String       @default("ROUTINE") // ROUTINE, GENETIC, MOLECULAR, BIOMARKER
  price          Float
  turnaroundTime String? // e.g. "24 hours"
  createdAt      DateTime     @default(now())
  bookings       LabBooking[]
}

model LabBooking {
  id          String     @id @default(cuid())
  patientId   String
  patient     User       @relation(fields: [patientId], references: [id])
  testId      String
  test        LabTest    @relation(fields: [testId], references: [id])
  status      String     @default("Pending") // Pending, Confirmed, Completed, Cancelled
  bookingDate DateTime   @default(now())
  report      LabReport?
  hospitalId  String?
  hospital    Hospital?  @relation(fields: [hospitalId], references: [id])
}

model LabReport {
  id         String     @id @default(cuid())
  bookingId  String     @unique
  booking    LabBooking @relation(fields: [bookingId], references: [id])
  reportUrl  String
  uploadedAt DateTime   @default(now())
}

model Retailer {
  id                 String              @id @default(cuid())
  userId             String?             @unique
  user               User?               @relation(fields: [userId], references: [id])
  shopName           String
  address            String
  licenseNumber      String
  phone              String
  city               String              @default("Gorakhpur")
  verified           Boolean             @default(false)
  isDirectory        Boolean             @default(false)
  isGenericStore     Boolean             @default(false)
  rating             Float               @default(4.5)
  ratingCount        Int                 @default(0)
  status             String              @default("unverified") // unverified, verified, claimed
  source             String              @default("field_agent") // google_maps, justdial, field_agent, self_registered
  lat                Float?
  lng                Float?
  photoUrl           String?
  openingHours       String              @default("9:00 AM - 10:00 PM")
  isOnline           Boolean             @default(false)
  priority_score     Int                 @default(0)
  createdAt          DateTime            @default(now())
  bulkOrders         BulkOrder[]
  inventory          RetailerInventory[]
  assignedOrders     Order[]             @relation("AssignedOrders")
  subOrders          SubOrder[]
  prescriptionQuotes PrescriptionQuote[]
  reports            Report[]

  // --- Settlement & Trust ---
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankUpi           String?
  bankVerified      Boolean             @default(false)
  trustLevel        String              @default("NEW") // NEW, VERIFIED, TRUSTED, PREMIUM, STRATEGIC
  kycStatus         String              @default("PENDING") // PENDING, APPROVED, REJECTED
  agreements        RetailerAgreement[]
  settlementItems   SettlementItem[]

  // --- Compliance & Commission System ---
  gstNumber            String?
  agreedPlatformMargin Float   @default(10.0) // Swastik Medicare 10% commission
  riderPreference      String  @default("SWASTIK") // SELF or SWASTIK
}

model Stockist {
  id               String      @id @default(cuid())
  userId           String      @unique
  user             User        @relation(fields: [userId], references: [id])
  agencyName       String
  warehouseAddress String
  gstNumber        String
  phone            String
  verified         Boolean     @default(false)
  createdAt        DateTime    @default(now())
  receivedOrders   BulkOrder[]
  inventory        StockistInventory[]
}

model BulkOrder {
  id          String    @id @default(cuid())
  retailerId  String
  retailer    Retailer  @relation(fields: [retailerId], references: [id])
  stockistId  String?
  stockist    Stockist? @relation(fields: [stockistId], references: [id])
  items       String // JSON string of items
  status      String    @default("Pending") // Pending, Accepted, Shipped, Delivered
  totalAmount Float
  createdAt   DateTime  @default(now())
}

model StockistInventory {
  id           String   @id @default(cuid())
  stockistId   String
  stockist     Stockist @relation(fields: [stockistId], references: [id])
  medicineName String   // Can map to Product name
  stock        Int
  price        Float    // Wholesale / Stockist Price
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model Ambulance {
  id            String             @id @default(cuid())
  userId        String?
  user          User?              @relation(fields: [userId], references: [id])
  driverName    String
  vehicleNumber String? // Optional for directory
  vehicleType   String // "Basic", "ICU", "Advance"
  city          String             @default("Gorakhpur")
  verified      Boolean            @default(false)
  isDirectory   Boolean            @default(false)
  isAvailable   Boolean            @default(true)
  phone         String
  rating        Float              @default(4.8)
  ratingCount   Int                @default(0)
  status        String             @default("unverified")
  photoUrl      String?
  currentLat    Float?
  currentLng    Float?
  pricePerKm    Float              @default(20.0)
  createdAt     DateTime           @default(now())
  bookings      AmbulanceBooking[]
}

model AmbulanceBooking {
  id            String    @id @default(cuid())
  ambulanceId   String
  ambulance     Ambulance @relation(fields: [ambulanceId], references: [id])
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  guestName     String?
  guestPhone    String?
  pickupAddress String
  dropAddress   String
  distanceKm    Float?
  totalPrice    Float?
  status        String    @default("Pending") // Pending, Accepted, Completed, Cancelled
  createdAt     DateTime  @default(now())
}

model MedicalRep {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  name       String
  company    String
  region     String
  phone      String
  status     String   @default("Pending") // Pending, Active
  verified   Boolean  @default(false)
  idImageUrl String? // Identity document URL
  createdAt  DateTime @default(now())
  visits     Visit[]
}

model PharmaCompany {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id])
  companyName   String
  licenseNumber String
  address       String
  phone         String
  createdAt     DateTime     @default(now())
  verified      Boolean      @default(false)
  ads           AdCampaign[]
}

model Visit {
  id        String     @id @default(cuid())
  mrId      String
  mr        MedicalRep @relation(fields: [mrId], references: [id])
  doctorId  String
  doctor    Doctor     @relation(fields: [doctorId], references: [id])
  date      DateTime
  notes     String?
  status    String     @default("Scheduled") // Scheduled, Completed
  createdAt DateTime   @default(now())
}

model AdCampaign {
  id            String         @id @default(cuid())
  companyId     String?
  pharmaCompany PharmaCompany? @relation(fields: [companyId], references: [id])
  title         String
  imageUrl      String
  targetUrl     String?
  position      String // "Home-Banner", "Sidebar"
  startDate     DateTime
  endDate       DateTime
  status        String         @default("Pending") // Pending, Active, Expired, Rejected
  price         Float
  createdAt     DateTime       @default(now())
}

model MedicineRequest {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  guestName       String?
  guestPhone      String?
  medicineName    String
  quantity        String
  prescriptionUrl String?
  status          String   @default("Pending") // Pending, Fulfilled, Cancelled
  createdAt       DateTime @default(now())
}

model Subscription {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  medicineName String
  quantity     Int
  frequency    String   @default("Monthly") // Monthly, Weekly
  nextDate     DateTime
  status       String   @default("Active") // Active, Paused, Cancelled
  createdAt    DateTime @default(now())
}

model RetailerInventory {
  id           String   @id @default(cuid())
  retailerId   String
  retailer     Retailer @relation(fields: [retailerId], references: [id])
  medicineName String
  stock        Int
  price        Float
  deliveryArea String // e.g., "Sector 62, Noida"
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model PharmacyInventory {
  id            String    @id @default(cuid())
  productId     String    @unique
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchasePrice Float     @default(0.0)
  sellingPrice  Float     @default(0.0)
  stock         Int       @default(0)
  expiryDate    DateTime?
  marginPercent Float     @default(0.0) // Margin percentage 
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())
}

model DeliveryAgent {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Basic Profile
  name             String?
  licenseNumber    String
  vehicleNumber    String
  phone            String
  city             String   @default("Gorakhpur")
  area             String?
  serviceRadius    Float    @default(5.0)
  profilePhotoUrl  String?
  vehicleType      String   @default("MOTORCYCLE") // BICYCLE, MOTORCYCLE, CAR, ELECTRIC_SCOOTER
  deliveryCapacity Int      @default(3)
  preferredAreas   String[] @default([])

  // Availability
  isOnline          Boolean   @default(false)
  isAvailable       Boolean   @default(false)
  lastActiveAt      DateTime?
  workingHoursStart String    @default("09:00")
  workingHoursEnd   String    @default("21:00")

  // Onboarding & Verification
  // Applied | Docs_Submitted | Under_Verification | Verified | Active | Suspended
  onboardingStatus String  @default("Applied")
  verified         Boolean @default(false)

  // Performance Metrics
  totalDeliveries        Int   @default(0)
  successfulDeliveries   Int   @default(0)
  cancelledDeliveries    Int   @default(0)
  avgDeliveryTimeMinutes Float @default(0.0)
  acceptanceRate         Float @default(100.0)
  completionRate         Float @default(100.0)
  customerRating         Float @default(5.0)
  pharmacyRating         Float @default(5.0)
  reliabilityScore       Float @default(100.0) // Composite 0-100

  // Referral Tracking
  referralSource    String?
  riderReferralCode String? @unique
  referredByRiderId String?

  // Earnings (direct bank transfer model)
  totalEarnings   Float @default(0.0)
  pendingEarnings Float @default(0.0)
  paidEarnings    Float @default(0.0)

  // Legacy
  walletBalance Float    @default(0.0)
  lat           Float?
  lng           Float?
  createdAt     DateTime @default(now())

  // Relations
  deliveries           Order[]                    @relation("AssignedDeliveries")
  assignments          DeliveryAssignment[]
  RiderLocationLog     RiderLocationLog[]
  DeliveryAlert        DeliveryAlert[]
  documents            RiderDocument[]
  deliveryJobs         DeliveryJob[]
  riderOffers          RiderOffer[]
  performanceSnapshots RiderPerformanceSnapshot[]
  fraudFlags           RiderFraudFlag[]

  @@index([onboardingStatus])
  @@index([city, area])
  @@index([isOnline, isAvailable])
}

model WalletTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Float
  type        String // "CREDIT" or "DEBIT"
  description String // e.g., "Level 1 Referral Bonus", "Delivery Payout", "Withdrawal"
  createdAt   DateTime @default(now())
}

model Withdrawal {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  amount         Float
  status         String   @default("Pending") // Pending, Completed, Rejected
  paymentMethod  String // e.g., "UPI", "Bank Transfer"
  paymentDetails String // JSON or string of account info
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model InsuranceCompany {
  id          String          @id @default(cuid())
  name        String
  logoUrl     String?
  description String?
  phone       String?
  email       String?
  website     String?
  plans       InsurancePlan[]
  leads       InsuranceLead[]
  user        User?           @relation("CompanyUser")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  insuranceProfiles InsuranceProfile[]
  insuranceNetworks InsuranceNetwork[]
}

model InsurancePlan {
  id             String           @id @default(cuid())
  companyId      String
  company        InsuranceCompany @relation(fields: [companyId], references: [id])
  name           String
  description    String?
  coverageType   String // Individual, Family, Hospitalization
  premium        Float
  commissionRate Float // Percentage or Fixed amount
  features       String[] // Array of features
  leads          InsuranceLead[]
  insuranceProfiles InsuranceProfile[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model InsuranceLead {
  id               String           @id @default(cuid())
  planId           String
  plan             InsurancePlan    @relation(fields: [planId], references: [id])
  companyId        String
  company          InsuranceCompany @relation(fields: [companyId], references: [id])
  userId           String? // Customer
  user             User?            @relation("CustomerLeads", fields: [userId], references: [id])
  publisherId      String? // Referrer
