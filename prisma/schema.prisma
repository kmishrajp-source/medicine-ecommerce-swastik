  activeRiders           Int    @default(0)
  ordersLast30Days       Int    @default(0)
  avgDeliveryTimeMinutes Float  @default(0.0)
  demandLevel            String @default("NORMAL") // LOW | NORMAL | HIGH | CRITICAL

