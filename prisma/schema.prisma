model RiderDocument {
  id              String        @id @default(cuid())
  riderId         String
  rider           DeliveryAgent @relation(fields: [riderId], references: [id])
  // AADHAAR, PAN, DRIVING_LICENSE, VEHICLE_RC, PHOTO, POLICE_CERT, OTHER
  docType         String
  docUrl          String
  // PENDING, APPROVED, REJECTED
  status          String        @default("PENDING")
  rejectionReason String?
  expiryDate      DateTime?
  uploadedAt      DateTime      @default(now())
  reviewedAt      DateTime?
  reviewedBy      String? // Admin userId

  @@index([riderId])
  @@index([status])
}

model ExternalDeliveryProvider {
  id              String   @id @default(cuid())
  name            String   @unique // e.g., "DUNZO", "SHADOWFAX", "PORTER"
  apiUrl          String?
  apiKey          String?
  isActive        Boolean  @default(true)
  baseFee         Float    @default(40.0)
  perKmFee        Float    @default(10.0)
  serviceCities   String[] @default(["Gorakhpur"])
  priority        Int      @default(1) // Lower number = higher priority
  supportedModes  String[] @default(["BIKE"])
  status          String   @default("CONFIGURED") // LIVE, CONFIGURED, INTEGRATION_REQUIRED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  jobs            DeliveryJob[]
}

model DeliveryJob {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation("DeliveryJobOrder", fields: [orderId], references: [id])

  // Pickup & Drop Coordinates
  pickupLat     Float?
  pickupLng     Float?
  dropLat       Float?
  dropLng       Float?
  pickupAddress String?
  dropAddress   String?

  // Status lifecycle
  // SEARCHING | OFFERED | ACCEPTED | PICKUP_CONFIRMED | IN_TRANSIT | DELIVERED | FAILED | CANCELLED
  status String @default("SEARCHING")

  // Rider Search State
  searchRadiusKm    Float          @default(5.0)
  offerCount        Int            @default(0)
  offeredRiderIds   String[]       @default([]) // History of all riders offered
  currentRiderId    String? // Currently offered rider
  acceptedRiderId   String?
  acceptedRider     DeliveryAgent? @relation(fields: [acceptedRiderId], references: [id])
  suitabilityScores Json? // { riderId: score, ... }

  // Timing
  timeoutAt   DateTime? // When current offer expires
  acceptedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?

  // Failure & Manual Override
  failureReason    String?
  adminOverrideBy  String?
  deliveryProofUrl String?

  // Fallback / Orchestration State
  deliveryMethod      String  @default("SWASTIK_RIDER") // SWASTIK_RIDER, EXTERNAL_PARTNER, RETAILER_DELIVERY, CUSTOMER_PICKUP
  externalProviderId  String?
  externalProvider    ExternalDeliveryProvider? @relation(fields: [externalProviderId], references: [id])
  externalTrackingUrl String?

  offers    RiderOffer[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
  @@index([acceptedRiderId])
}

model RiderOffer {
  id      String        @id @default(cuid())
  jobId   String
  job     DeliveryJob   @relation(fields: [jobId], references: [id])
  riderId String
  rider   DeliveryAgent @relation(fields: [riderId], references: [id])

  offeredAt   DateTime  @default(now())
  respondedAt DateTime?
  // PENDING | ACCEPTED | DECLINED | TIMEOUT
  response    String    @default("PENDING")

  suitabilityScore Float  @default(0.0)
  distanceKm       Float?
  estimatedMinutes Int?

  @@index([jobId])
  @@index([riderId])
  @@index([response])
}

model RiderPerformanceSnapshot {
  id      String        @id @default(cuid())
  riderId String
  rider   DeliveryAgent @relation(fields: [riderId], references: [id])

  // DAILY | WEEKLY | MONTHLY
  period     String
  periodDate DateTime // Start of the period

  deliveriesCompleted Int   @default(0)
  deliveriesCancelled Int   @default(0)
  avgTimeMinutes      Float @default(0.0)
  acceptanceRate      Float @default(0.0)
  completionRate      Float @default(0.0)
  customerRating      Float @default(5.0)
  pharmacyRating      Float @default(5.0)
  reliabilityScore    Float @default(100.0)
  earningsThisPeriod  Float @default(0.0)

  // EXCELLENT | GOOD | AVERAGE | POOR
  performanceTier String  @default("GOOD")
  alerts          Json? // [{ type, message }]
  reviewedByAdmin Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([riderId, period, periodDate])
  @@index([riderId])
  @@index([period])
}

model RiderRecruitmentCampaign {
  id         String  @id @default(cuid())
  title      String
  // WHATSAPP | SMS | QR_CODE | REFERRAL_LINK | WEBSITE | SOCIAL | PHARMACY_NETWORK
  channel    String
  targetArea String?
  targetCity String  @default("Gorakhpur")

  // DRAFT | ACTIVE | PAUSED | COMPLETED
  status String @default("DRAFT")

  // Funnel Metrics
  impressions        Int @default(0)
  clicks             Int @default(0)
  applications       Int @default(0)
  verifiedRiders     Int @default(0)
  activatedRiders    Int @default(0)
  firstDeliveryCount Int @default(0)
  activeAfter30Days  Int @default(0)

  acquisitionCost Float? // Cost per activated rider (if paid channel)
  campaignContent Json? // { message, imagePrompt, templateName, qrCodeUrl }

  startDate      DateTime?
  endDate        DateTime?
  createdByAdmin String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  applications_rel RiderApplication[]

  @@index([status])
  @@index([channel])
}

model RiderApplication {
  id          String  @id @default(cuid())
  name        String
  phone       String
  city        String  @default("Gorakhpur")
  area        String?
  vehicleType String  @default("MOTORCYCLE")

  // Which campaign/referral code brought them
  referralCode String?
  campaignId   String?
  campaign     RiderRecruitmentCampaign? @relation(fields: [campaignId], references: [id])

  // Application lifecycle
  // APPLIED | DOCS_SUBMITTED | UNDER_VERIFICATION | VERIFIED | ACTIVE | REJECTED
  status          String  @default("APPLIED")
  rejectionReason String?
  notes           String?

  // Linked DeliveryAgent once converted
  convertedRiderId String?

  // Fraud Analysis
  fraudScore Float @default(0.0)
  fraudFlags Json? // [{ type, detail }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrals        RiderReferral[]
  fraudFlagRecords RiderFraudFlag[]

  @@index([status])
  @@index([phone])
  @@index([referralCode])
}

model RiderReferral {
  id           String @id @default(cuid())
  referralCode String

  // Referrer
  referrerId   String // DeliveryAgent.id or User.id
  referrerType String // RIDER | CUSTOMER | PHARMACY | DOCTOR | EMPLOYEE

  // Application + Converted Rider
  applicationId String?
  application   RiderApplication? @relation(fields: [applicationId], references: [id])
  riderId       String? // Filled when application converts to DeliveryAgent

  // Lifecycle
  // INVITED | APPLIED | VERIFIED | ACTIVE | QUALIFIED | REWARD_PENDING | REWARD_PAID | CANCELLED
  status String @default("INVITED")

  // Qualifying conditions
  qualifyingDeliveries    Int     @default(10) // How many deliveries needed
  qualifyingDeliveriesMet Boolean @default(false)

  // Reward (direct bank transfer)
  rewardAmount Float     @default(0.0)
  rewardPaidAt DateTime?
  bankDetails  Json? // { accountName, accountNumber, ifsc, upi }

  // Fraud review
  fraudFlag           Boolean @default(false)
  fraudReason         String?
  adminReviewRequired Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerId])
  @@index([status])
  @@index([referralCode])
}

model RiderFraudFlag {
  id            String            @id @default(cuid())
  riderId       String?
  rider         DeliveryAgent?    @relation(fields: [riderId], references: [id])
  applicationId String?
  application   RiderApplication? @relation(fields: [applicationId], references: [id])

  // DUPLICATE_PHONE | SELF_REFERRAL | CIRCULAR_REFERRAL | SUSPICIOUS_ACTIVITY | FAKE_DOCUMENTS | HIGH_FREQUENCY
  flagType String
  details  Json? // Supporting evidence
  // LOW | MEDIUM | HIGH
  severity String @default("MEDIUM")
  // OPEN | REVIEWED | CLEARED | CONFIRMED
  status   String @default("OPEN")

  reviewedByAdmin String?
  reviewNotes     String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([status])
  @@index([flagType])
}

model DeliveryZone {
  id      String @id @default(cuid())
  name    String
  city    String @default("Gorakhpur")
  area    String
  polygon Json? // Array of { lat, lng } defining the zone boundary

