// GPS TRACKING SYSTEM

// Breadcrumb trail of every GPS ping for route replay and deviation detection
model RiderLocationLog {
  id        String        @id @default(cuid())
  agentId   String
  agent     DeliveryAgent @relation(fields: [agentId], references: [id])
  orderId   String? // Active order at time of ping
  lat       Float
  lng       Float
  heading   Float? // Degrees 0-360
  speed     Float? // km/h
  accuracy  Float? // GPS accuracy in meters
  createdAt DateTime      @default(now())

  @@index([agentId])
  @@index([orderId])
  @@index([createdAt])
}

